PORT=2703
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_KEY=replace_with_a_long_random_secret

# Server-only: generate with node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Comma-separated exact frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
